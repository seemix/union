# Dev only (ignored when NODE_ENV=production): force a site regardless of the Host header,
# so plain http://localhost:3000 works. Allowed: ru | ro. Empty = resolve by Host.
SITE_OVERRIDE=

# Secret for the post views counter endpoint of the ru site (shared with the WordPress plugin).
VIEWS_SECRET_RU=

# Secret for the post views counter endpoint of the ro site (shared with the WordPress plugin).
VIEWS_SECRET_RO=

# Secret token that authorizes on-demand revalidation requests (e.g. from WordPress webhooks).
REVALIDATE_SECRET=
