# Dev only (ignored when NODE_ENV=production): force a site regardless of the Host header,
# so plain http://localhost:3000 works. Allowed: ru | ro. Empty = resolve by Host.
SITE_OVERRIDE=

# Server-only secret for WP POST baptist/v1/views/{id} of the ru site: = UNION_VIEWS_SECRET in ru wp-config.php.
# Never exposed to the browser (no NEXT_PUBLIC_ prefix). Empty = views are not counted.
VIEWS_SECRET_RU=

# Same for the ro site: = UNION_VIEWS_SECRET in ro wp-config.php.
VIEWS_SECRET_RO=

# Secrets of POST /api/revalidate, one per site: = UNION_REVALIDATE_SECRET in that site's wp-config.php
# (sent by the baptist-headless mu-plugin as X-Union-Secret). Empty = revalidation requests are rejected (401).
REVALIDATE_SECRET_RU=
REVALIDATE_SECRET_RO=
